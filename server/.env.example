# MaintainEase – Environment Variables
# Copy this file to .env and fill in your own values
# Do NOT commit .env to version control

# MongoDB connection string
# Local development:
MONGO_URI=mongodb://localhost:27017/maintainease
# Render / Atlas (replace with your actual URI):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/maintainease

# JWT secret — change this to a long random string in production
JWT_SECRET=maintainease_secret_key_change_in_prod

# JWT token expiry
JWT_EXPIRES=7d

# Server port (Render sets this automatically)
PORT=3000
